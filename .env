# Copie este arquivo para .env e ajuste os valores

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/logistica

# Diretório onde os artefatos do modelo são salvos
ARTIFACTS_DIR=app/ml/artifacts

# Número mínimo de novas entregas finalizadas para disparar retreino automático
RETREINO_MIN_AMOSTRAS=100

# JWT
SECRET_KEY=logistica-ia-chave-secreta-2026-troque-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480