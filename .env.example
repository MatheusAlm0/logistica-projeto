# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/logistica

# JWT — obrigatória (mín. 32 caracteres); a API não sobe com este placeholder.
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-longo-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML
ARTIFACTS_DIR=app/ml/artifacts
RETREINO_MIN_AMOSTRAS=100